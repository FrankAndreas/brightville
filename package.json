{
  "name": "brightville",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "postinstall": "node scripts/fetch-pose-assets.mjs",
    "fetch-pose-assets": "node scripts/fetch-pose-assets.mjs",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:web": "vite"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "pinia": "^4.1.0",
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
