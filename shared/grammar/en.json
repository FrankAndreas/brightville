    {"id": "present-simple-continuous", "name": "Present simple / continuous", "rule": "Gewohnheit → present simple; gerade jetzt → am/is/are + -ing", "kind": "choice", "items": [{"id": "1", "text": "Tom ___ football every Saturday.", "answers": ["plays"], "wrong": ["is playing", "play", "playing"], "hint": "(play)"}, {"id": "2", "text": "Look! It ___ outside.", "answers": ["is snowing"], "wrong": ["snows", "snow", "snowing"], "hint": "(snow)"}, {"id": "3", "text": "My mum ___ in an office in Bern.", "answers": ["works"], "wrong": ["is working", "work", "working"], "hint": "(work)"}, {"id": "4", "text": "Be quiet, please. The baby ___.", "answers": ["is sleeping"], "wrong": ["sleeps", "sleep", "sleeping"], "hint": "(sleep)"}, {"id": "5", "text": "We usually ___ the bus to school.", "answers": ["take"], "wrong": ["are taking", "takes", "taking"], "hint": "(take)"}, {"id": "6", "text": "Right now I ___ my homework.", "answers": ["am doing"], "wrong": ["do", "does", "doing"], "hint": "(do)"}, {"id": "7", "text": "She ___ coffee. She only drinks tea.", "answers": ["doesn't like", "does not like"], "wrong": ["isn't liking", "don't like", "not likes"], "hint": "(not like)"}, {"id": "8", "text": "Listen! Someone ___ the piano.", "answers": ["is playing"], "wrong": ["plays", "play", "playing"], "hint": "(play)"}, {"id": "9", "text": "The train ___ at 7.15 every morning.", "answers": ["leaves"], "wrong": ["is leaving", "leave", "leaving"], "hint": "(leave)"}, {"id": "10", "text": "What ___ at the moment? – A comic.", "answers": ["are you reading"], "wrong": ["do you read", "you are reading", "does you read"], "hint": "(you · read)"}, {"id": "11", "text": "They ___ in Zurich. They live in Basel.", "answers": ["don't live", "do not live"], "wrong": ["aren't living", "doesn't live", "not live"], "hint": "(not live)"}, {"id": "12", "text": "Hurry up! Everybody ___ for you.", "answers": ["is waiting"], "wrong": ["waits", "wait", "are waiting"], "hint": "(wait)"}, {"id": "13", "text": "My brother never ___ his bed.", "answers": ["makes"], "wrong": ["is making", "make", "making"], "hint": "(make)"}, {"id": "14", "text": "Water ___ at 100 degrees.", "answers": ["boils"], "wrong": ["is boiling", "boil", "boiling"], "hint": "(boil)"}, {"id": "15", "text": "Why ___ a jacket? It's hot today!", "answers": ["are you wearing"], "wrong": ["do you wear", "you are wearing", "does you wear"], "hint": "(you · wear)"}, {"id": "16", "text": "Lisa ___ to music every evening.", "answers": ["listens"], "wrong": ["is listening", "listen", "listening"], "hint": "(listen)"}, {"id": "17", "text": "I can't talk now. I ___ dinner.", "answers": ["am cooking"], "wrong": ["cook", "cooks", "cooking"], "hint": "(cook)"}, {"id": "18", "text": "How often ___ your grandparents?", "answers": ["do you visit"], "wrong": ["are you visiting", "does you visit", "you visit"], "hint": "(you · visit)"}, {"id": "19", "text": "This week Paul ___ at his uncle's farm.", "answers": ["is staying"], "wrong": ["stays", "stay", "staying"], "hint": "(stay)"}, {"id": "20", "text": "The shops ___ at 6 o'clock on Saturdays.", "answers": ["close"], "wrong": ["are closing", "closes", "closing"], "hint": "(close)"}]},
    {"id": "past-simple", "name": "Past simple", "rule": "Vergangenheit: regelmässig -ed; unregelmässige Verben lernen (go → went)", "kind": "form", "persons": ["I", "you", "he", "she", "we", "they"], "verbs": {"go": {"forms": "went", "wrong": ["goed", "gone"]}, "buy": {"forms": "bought", "wrong": ["buyed", "buys"]}, "see": {"forms": "saw", "wrong": ["seed", "seen"]}, "eat": {"forms": "ate", "wrong": ["eated", "eaten"]}, "drink": {"forms": "drank", "wrong": ["drinked", "drunk"]}, "write": {"forms": "wrote", "wrong": ["writed", "written"]}, "take": {"forms": "took", "wrong": ["taked", "taken"]}, "come": {"forms": "came", "wrong": ["comed", "comes"]}, "get": {"forms": "got", "wrong": ["getted", "gets"]}, "make": {"forms": "made", "wrong": ["maked", "makes"]}, "meet": {"forms": "met", "wrong": ["meeted", "meets"]}, "find": {"forms": "found", "wrong": ["finded", "finds"]}, "lose": {"forms": "lost", "wrong": ["losed", "loses"]}, "leave": {"forms": "left", "wrong": ["leaved", "leaves"]}, "swim": {"forms": "swam", "wrong": ["swimmed", "swum"]}, "ride": {"forms": "rode", "wrong": ["rided", "ridden"]}, "read": {"forms": "read", "wrong": ["readed", "red", "reads"]}, "sing": {"forms": "sang", "wrong": ["singed", "sung"]}, "run": {"forms": "ran", "wrong": ["runned", "runs"]}, "win": {"forms": "won", "wrong": ["winned", "wins"]}, "forget": {"forms": "forgot", "wrong": ["forgetted", "forgotten"]}, "bring": {"forms": "brought", "wrong": ["bringed", "brang"]}, "think": {"forms": "thought", "wrong": ["thinked", "thinks"]}, "teach": {"forms": "taught", "wrong": ["teached", "teaches"]}, "catch": {"forms": "caught", "wrong": ["catched", "catches"]}, "sleep": {"forms": "slept", "wrong": ["sleeped", "sleeps"]}, "speak": {"forms": "spoke", "wrong": ["speaked", "spoken"]}, "break": {"forms": "broke", "wrong": ["breaked", "broken"]}, "give": {"forms": "gave", "wrong": ["gived", "given"]}, "fall": {"forms": "fell", "wrong": ["falled", "fallen"]}, "have": {"forms": "had", "wrong": ["haved", "