    {"id": "some-any", "name": "some / any, much / many", "rule": "some: bejaht; any: Frage, Verneinung; much: nicht zählbar; many: zählbar", "kind": "choice", "items": [{"id": "1", "text": "There are ___ apples in the fridge.", "answers": ["some"], "wrong": ["any", "much", "a"]}, {"id": "2", "text": "Have you got ___ brothers or sisters?", "answers": ["any"], "wrong": ["some", "much", "a"]}, {"id": "3", "text": "I haven't got ___ money with me.", "answers": ["any"], "wrong": ["some", "many", "no"]}, {"id": "4", "text": "How ___ water do you drink a day?", "answers": ["much"], "wrong": ["many", "any", "some"]}, {"id": "5", "text": "How ___ people live in Bern?", "answers": ["many"], "wrong": ["much", "any", "lot"]}, {"id": "6", "text": "Would you like ___ tea?", "answers": ["some"], "wrong": ["any", "many", "a"]}, {"id": "7", "text": "There isn't ___ milk left.", "answers": ["any"], "wrong": ["some", "many", "no"]}, {"id": "8", "text": "We don't have ___ time. Hurry up!", "answers": ["much"], "wrong": ["many", "some", "lot"]}, {"id": "9", "text": "She has ___ friends in Geneva.", "answers": ["many"], "wrong": ["much", "any", "lot"]}, {"id": "10", "text": "Is there ___ bread for breakfast?", "answers": ["any"], "wrong": ["some", "many", "a"]}, {"id": "11", "text": "Can I have ___ chips, please?", "answers": ["some"], "wrong": ["any", "much", "a"]}, {"id": "12", "text": "There weren't ___ students in the classroom.", "answers": ["many"], "wrong": ["much", "some", "lot"]}, {"id": "13", "text": "I need ___ help with my homework.", "answers": ["some"], "wrong": ["any", "many", "a"]}, {"id": "14", "text": "He doesn't eat ___ meat.", "answers": ["much"], "wrong": ["many", "some", "lot"]}, {"id": "15", "text": "Are there ___ good films on TV tonight?", "answers": ["any"], "wrong": ["some", "much", "a"]}, {"id": "16", "text": "I bought ___ new shoes.", "answers": ["some"], "wrong": ["any", "much", "a"]}, {"id": "17", "text": "How ___ homework do you have?", "answers": ["much