    {"id": "adverbs", "name": "Adverbien (-ly)", "rule": "Wie tut man etwas? → Adverb: slow → slowly; good → well; fast, hard bleiben", "kind": "choice", "items": [{"id": "1", "text": "Please speak ___. I can't understand you.", "answers": ["slowly"], "wrong": ["slow", "slowlier", "more slow"], "hint": "(slow)"}, {"id": "2", "text": "She sings very ___.", "answers": ["well"], "wrong": ["good", "goodly", "best"], "hint": "(good)"}, {"id": "3", "text": "He drives too ___.", "answers": ["fast"], "wrong": ["fastly", "faster", "fasting"], "hint": "(fast)"}, {"id": "4", "text": "The children played ___ in the garden.", "answers": ["happily"], "wrong": ["happy", "happyly", "happier"], "hint": "(happy)"}, {"id": "5", "text": "Read the questions ___.", "answers": ["carefully"], "wrong": ["careful", "carefuly", "carefull"], "hint": "(careful)"}, {"id": "6", "text": "I worked very ___ for the test.", "answers": ["hard"], "wrong": ["hardly", "harder", "hardy"], "hint": "(hard)"}, {"id": "7", "text": "The dog barked ___ all night.", "answers": ["loudly"], "wrong": ["loud", "loudy", "loudlier"], "hint": "(loud)"}, {"id": "8", "text": "She answered the question ___.", "answers": ["correctly"], "wrong": ["correct", "correctely", "correctlier"], "hint": "(correct)"}, {"id": "9", "text": "He closed the door ___ so the baby didn't wake up.", "answers": ["quietly"], "wrong": ["quiet", "quietely", "quite"], "hint": "(quiet)"}, {"id": "10", "text": "You did that really ___!", "answers": ["well"], "wrong": ["good", "goodly", "better"], "hint": "(good)"}, {"id": "11", "text": "It was raining ___.", "answers": ["heavily"], "wrong": ["heavy", "heavyly", "heavier"], "hint": "(heavy)"}, {"id": "12", "text": "Our teacher explains things ___.", "answers": ["clearly"], "wrong": ["clear", "clearely", "more clear"], "hint": "(clear)"}, {"id": "13", "text": "He ___ finished his homework before dinner.", "answers": ["quickly"], "wrong": ["quick", "quickely", "quicker"], "hint": "(quick)"}, {"id": "14", "text": "The old man walked ___ up the hill.", "answers": ["slowly"], "wrong": ["slow", "slowely", "slowlier"], "hint": "(slow)"}, {"id": "15", "text": "She smiled ___ at me.", "answers": ["nicely"], "wrong": ["nice", "nicly", "nicer"], "hint": "(nice)"}, {"id": "16", "text": "We arrived ___ because of the snow.", "answers": ["late"], "wrong": ["lately", "later", "lates"], "hint": "(late)"}, {"id": "17", "text": "The team played ___ and lost 0:3.", "answers": ["badly"], "wrong": ["bad", "badily", "worse"], "hint": "(bad)"}, {"id": "18", "text": "Please write ___ so I can read it.", "answers": ["neatly"], "wrong": ["neat", "neatily", "neater"], "hint": "(neat)"}]},
    {"id": "relatives", "name": "who / which / that", "rule": "Personen → who; Dinge, Tiere → which; that geht für beides", "kind": "choice", "items": [{"id": "1", "text": "The girl ___ sits next to me is from Basel.", "answers": ["who", "that"], "wrong": ["which", "what", "where"]}, {"id": "2", "text": "This is the book ___ I told you about.", "answers": ["which", "that"], "wrong": ["who", "what", "where"]}, {"id": "3", "text": "I have a friend ___ speaks four languages.", "answers": ["who", "that"], "wrong": ["which", "what", "whose"]}, {"id": "4", "text": "The bike ___ I bought last year is already broken.", "answers": ["which", "that"], "wrong": ["who", "what", "where"]}, {"id": "5", "text": "Do you know the man ___ lives next door?", "answers": ["who", "that"], "wrong": ["which", "what", "where"]}, {"id": "6", "text": "The cake ___ my mum made was delicious.", "answers": ["which", "that"], "wrong": ["who", "what", "whose"]}, {"id": "7", "text": "A teacher is a person ___ helps people learn.", "answers": ["who", "that"], "wrong": ["which", "what", "where"]}, {"id": "8", "text": "This is the bus ___ goes to the airport.", "answers": ["which", "that"], "wrong": ["who", "what", "where"]}, {"id": "9", "text": "The players ___ won the match were very happy.", "answers": ["who", "that"], "wrong": ["which", "what", "whose"]}, {"id": "10", "text": "I lost the key ___ opens the garage.", "answers": ["which", "that"], "wrong": ["who", "what", "where"]}, {"id": "11", "text": "She's the singer ___ won the competition.", "answers": ["who", "that"], "wrong": ["which", "what", "where"]}, {"id": "12", "text": "The film ___ we saw yesterday was boring.", "answers": ["which", "that"], "wrong": ["who", "what", "whose"]}, {"id": "13", "text": "Is that the boy ___ broke the window?", "answers": ["who", "that"], "wrong": ["which", "what", "where"]}, {"id": "14", "text": "A fridge is a machine ___ keeps food cold.", "answers": ["which", "that"], "wrong": ["who", "what", "where"]}, {"i