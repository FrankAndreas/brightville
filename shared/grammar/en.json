    {"id": "if-will", "name": "If-Sätze (Typ 1)", "rule": "If + present simple, … will + Grundform", "kind": "choice", "items": [{"id": "1", "text": "If it rains tomorrow, we ___ at home.", "answers": ["will stay"], "wrong": ["stay", "would stay", "stayed"], "hint": "(stay)"}, {"id": "2", "text": "If you ___ hard, you will pass the test.", "answers": ["study"], "wrong": ["will study", "studied", "studies"], "hint": "(study)"}, {"id": "3", "text": "If she ___ the bus, she will be late.", "answers": ["misses"], "wrong": ["will miss", "miss", "missed"], "hint": "(miss)"}, {"id": "4", "text": "I will call you if I ___ time.", "answers": ["have"], "wrong": ["will have", "had", "has"], "hint": "(have)"}, {"id": "5", "text": "If we ___ now, we'll catch the train.", "answers": ["leave"], "wrong": ["will leave", "left", "leaves"], "hint": "(leave)"}, {"id": "6", "text": "If you eat all that cake, you ___ sick.", "answers": ["will feel"], "wrong": ["feel", "would feel", "felt"], "hint": "(feel)"}, {"id": "7", "text": "If it ___ sunny, we will go to the lake.", "answers": ["is"], "wrong": ["will be", "was", "be"], "hint": "(be)"}, {"id": "8", "text": "Mum ___ angry if you don't tidy your room.", "answers": ["will be"], "wrong": ["is", "would be", "be"], "hint": "(be)"}, {"id": "9", "text": "If he ___ the answer, he will tell us.", "answers": ["knows"], "wrong": ["will know", "know", "knew"], "hint": "(know)"}, {"id": "10", "text": "If you don't hurry, you ___ the start of the film.", "answers": ["will miss"], "wrong": ["miss", "missed", "would miss"], "hint": "(miss)"}, {"id": "11", "text": "If I ___ my homework early, I can play football.", "answers": ["finish"], "wrong": ["will finish", "finished", "finishes"], "hint": "(finish)"}, {"id": "12", "text": "We will go skiing if there ___ enough snow.", "answers": ["is"], "wrong": ["will be", "was", "are"], "hint": "(be)"}, {"id": "13", "text": "If they ___ the match, they will be champions.", "answers": ["win"], "wrong": ["will win", "won", "wins"], "hint": "(win)"}, {"id": "14", "text": "If you press this button, the machine ___.", "answers": ["will start"], "wrong": ["starts to", "started", "would start"], "hint": "(start)"}, {"id": "15", "text": "If my parents ___ yes, I'll come to the camp.", "answers": ["say"], "wrong": ["will say", "said", "says"], "hint": "(say)"}, {"id": "16", "text": "You'll get wet if you ___ an umbrella.", "answers": ["don't take", "do not take"], "wrong": ["won't take", "didn't take", "not take"], "hint": "(not take)"}, {"id": "17", "text": "If the shop is closed, we ___ tomorrow.", "answers": ["will come back"], "wrong": ["come back", "came back", "would come back"], "hint": "(come back)"}, {"id": "18", "text": "If I see Lena, I ___ her the news.", "answers": ["will tell"], "wrong": ["tell", "told", "would tell"], "hint": "(tell)"}]},
    {"id": "passive", "name": "Passiv", "rule": "Passiv: am/is/are oder was/were + 3. Form (by … = von …)", "kind": "choice", "items": [{"id": "1", "text": "English ___ in many countries.", "answers": ["is spoken"], "wrong": ["speaks", "is speaked", "spoken"], "hint": "(speak)"}, {"id": "2", "text": "This castle ___ in 1250.", "answers": ["was built"], "wrong": ["is built", "built", "was builded"], "hint": "(build)"}, {"id": "3", "text": "The letters ___ every morning.", "answers": ["are delivered"], "wrong": ["deliver", "is delivered", "are deliver"], "hint": "(deliver)"}, {"id": "4", "text": "The thief ___ by the police yesterday.", "answers": ["was caught"], "wrong": ["was catched", "caught", "is caught"], "hint": "(catch)"}, {"id": "5", "text": "Cheese ___ in this village.", "answers": ["is made"], "wrong": ["makes", "is maked", "made"], "hint": "(make)"}, {"id": "6", "text": "The windows ___ last week.", "answers": ["were cleaned"], "wrong": ["was cleaned", "cleaned", "are cleaned"], "hint": "(clean)"}, {"id": "7", "text": "Harry Potter ___ by J. K. Rowling.", "answers": ["was written"], "wrong": ["was wrote", "wrote", "is writing"], "hint": "(write)"}, {"id": "8", "text": "Tickets ___ at the entrance.", "answers": ["are sold"], "wrong": ["sell", "is sold", "are sell"], "hint": "(sell)"}, {"id": "9", "text": "My bike ___ last night!", "answers": ["was stolen"], "wrong": ["was stealed", "stole", "is stolen"], "hint": "(steal)"}, {"id": "10", "text": "The museum ___ on Mondays.", "answers": ["is closed"], "wrong": ["closes", "is close", "closed"], "hint": "(close)"}, {"id": "11", "text": "The first watches ___ in Switzerland long ago.", "answers": ["were made"], "wrong": ["was made", "made", "are made"], "hint": "(make)"}, {"id": "12", "text": "Our homework ___ by the teacher every Friday.", "answers": ["is checked"], "wrong": ["checks", "is check", "are checked"], "hint": "(check)"}, {"id": "13", "text": "The match ___ because of the rain.", "answers": ["was cancelled"], "wrong": ["cancelled", "is cancel", "was cancel"], "hint": "(cancel)"}, {"id": "14", "text": "Coffee ___ in Brazil.", "answers": ["is grown"], "wrong": ["grows in", "is growed", "grown"], "hint": "(grow)"}, {"id": "15", "text": "These photos ___ by my grandfather.", "answers": ["were taken"], "wrong": ["was taken", "took", "were took"], "hint": "(take)"}, {"id": "16", "text": "The streets ___ every morning.", "answers": ["are cleaned"], "wrong": ["clean", "is cleaned", "are clean"], "hint": "(clean)"}, {"id": "17", "text": "The new school ___ next to the park last year.", "answers": ["was opened"], "wrong": ["opened", "is opened", "was open"], "hint": "(open)"}, {"id": "18", "text": "Many languages ___ in Switzerland.", "answers": ["are spoken"], "wrong": ["speak", "is spoken", "are speaked"], "hint": "(speak)"}]}
