    {"id": "modals", "name": "can / must / have to / should", "rule": "nach can, must, should: Grundform ohne to; mustn't = darf nicht; has to = muss", "kind": "choice", "items": [{"id": "1", "text": "I ___ swim. I learned it when I was six.", "answers": ["can"], "wrong": ["must", "should", "have to"]}, {"id": "2", "text": "You ___ use your phone during the test. It's forbidden.", "answers": ["mustn't", "must not"], "wrong": ["don't have to", "can", "should"]}, {"id": "3", "text": "Tomorrow is Sunday, so we ___ get up early.", "answers": ["don't have to", "do not have to"], "wrong": ["mustn't", "can't", "haven't to"]}, {"id": "4", "text": "She ___ wear glasses to read.", "answers": ["has to"], "wrong": ["have to", "must to", "has"]}, {"id": "5", "text": "You look tired. You ___ go to bed.", "answers": ["should"], "wrong": ["can", "mustn't", "has to"]}, {"id": "6", "text": "___ you help me, please?", "answers": ["Can"], "wrong": ["Must", "Have", "Should to"]}, {"id": "7", "text": "He ___ come to the party. He is ill.", "answers": ["can't", "cannot", "can not"], "wrong": ["mustn't to", "doesn't can", "can"]}, {"id": "8", "text": "All students ___ wear a helmet on the bike tour.", "answers": ["must"], "wrong": ["can", "should to", "has to"]}, {"id": "9", "text": "You ___ eat so many sweets. It's bad for your teeth.", "answers": ["shouldn't", "should not"], "wrong": ["can", "don't have", "must"]}, {"id": "10", "text": "Do I ___ bring my own lunch?", "answers": ["have to"], "wrong": ["must", "has to", "should to"]}, {"id": "11", "text": "My little brother ___ read yet.", "answers": ["can't", "cannot", "can not"], "wrong": ["can", "doesn't can", "mustn't"]}, {"id": "12", "text": "We ___ be quiet in the library.", "answers": ["must"], "wrong": ["can", "has to", "should to"]}, {"id": "13", "text": "You ___ pay. The museum is free today.", "answers": ["don't have to", "do not have to"], "wrong": ["mustn't", "haven't to", "can't"]}, {"id": "14", "text": "I ___ finish my proje