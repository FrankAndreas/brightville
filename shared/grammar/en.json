    {"id": "do-questions", "name": "Fragen und Verneinung (do/does/did)", "rule": "Fragen/Verneinung: do/does (he/she/it) oder did + Grundform", "kind": "choice", "items": [{"id": "1", "text": "___ you like chocolate?", "answers": ["Do"], "wrong": ["Does", "Are", "Did you"]}, {"id": "2", "text": "___ your sister play the guitar?", "answers": ["Does"], "wrong": ["Do", "Is", "Has"]}, {"id": "3", "text": "I ___ football. I prefer tennis.", "answers": ["don't play", "do not play"], "wrong": ["doesn't play", "not play", "no play"], "hint": "(not play)"}, {"id": "4", "text": "He ___ meat. He's a vegetarian.", "answers": ["doesn't eat", "does not eat"], "wrong": ["don't eat", "not eats", "doesn't eats"], "hint": "(not eat)"}, {"id": "5", "text": "___ you go to the cinema yesterday?", "answers": ["Did"], "wrong": ["Do", "Have", "Were"]}, {"id": "6", "text": "We ___ the bus this morning. We walked.", "answers": ["didn't take", "did not take"], "wrong": ["didn't took", "don't took", "not took"], "hint": "(not take)"}, {"id": "7", "text": "Where ___ your parents work?", "answers": ["do"], "wrong": ["does", "are", "is"]}, {"id": "8", "text": "What time ___ the film start?", "answers": ["does"], "wrong": ["do", "is", "has"]}, {"id": "9", "text": "Why ___ you call me last night?", "answers": ["didn't", "did not"], "wrong": ["don't", "haven't", "weren't"]}, {"id": "10", "text": "She ___ to school on Monday because she was ill.", "answers": ["didn't go", "did not go"], "wrong": ["didn't went", "don't go", "not went"], "hint": "(not go)"}, {"id": "11", "text": "Did you ___ the news?", "answers": ["hear"], "wrong": ["heard", "hears", "hearing"], "hint": "(hear)"}, {"id": "12", "text": "Does he ___ in Bern?", "answers": ["live"], "wrong": ["lives", "lived", "living"], "hint": "(live)"}, {"id": "13", "text": "My dog ___ cats.", "answers": ["doesn't like", "does not like"], "wrong": ["don't like", "doesn't likes", "not like"], "hint": "(not like)"}, {"id": "14", "text": "How ___ you spell your name?", "answers": ["do"], "wrong": ["does", "are", "is"]}, {"id": "15", "text": "___ they win the game last week?", "answers": ["Did"], "wrong": ["Do", "Does", "Have"]}, {"id": "16", "text": "I ___ my homework yesterday. I forgot.", "answers": ["didn't do", "did not do"], "wrong": ["didn't did", "don't do", "not did"], "hint": "(not do)"}, {"id": "17", "text": "___ your brother have a car?", "answers": ["Does"], "wrong": ["Do", "Has", "Is"]}, {"id": "18", "text": "What ___ you have for breakfast this morning?", "answers": ["did"], "wrong": ["do", "does", "were"]}]},
    {"id": "comparison", "name": "Steigerung", "rule": "kurz: -er / the -est; lang: more / the most; good → better → the best", "kind": "choice", "items": [{"id": "1", "text": "My brother is ___ than me.", "answers": ["taller"], "wrong": ["more tall", "tallest", "the taller"], "hint": "(tall)"}, {"id": "2", "text": "This is the ___ day of the year.", "answers": ["hottest"], "wrong": ["hotest", "most hot", "hotter"], "hint": "(hot)"}, {"id": "3", "text": "Maths is ___ than French for me.", "answers": ["easier"], "wrong": ["more easy", "easyer", "easiest"], "hint": "(easy)"}, {"id": "4", "text": "This book is ___ than the film.", "answers": ["more interesting"], "wrong": ["interestinger", "most interesting", "more interestinger"], "hint": "(interesting)"}, {"id": "5", "text": "Anna is the ___ player in our team.", "answers": ["best"], "wrong": ["goodest", "better", "most good"], "hint": "(good)"}, {"id": "6", "text": "My cold is ___ today than yesterday.", "answers": ["worse"], "wrong": ["badder", "worst", "more bad"], "hint": "(bad)"}, {"id": "7", "text": "The Matterhorn is one of the ___ mountains in Switzerland.", "answers": ["most famous"], "wrong": ["famousest", "more famous", "famouser"], "hint": "(famous)"}, {"id": "8", "text": "Bern is ___ than Zurich.", "answers": ["smaller"], "wrong": ["more small", "smallest", "smaler"], "hint": "(small)"}, {"id": "9", "text": "Which is the ___ river in Europe?", "answers": ["longest"], "wrong": ["most long", "longer", "longgest"], "hint": "(long)"}, {"id": "10", "text": "Trains are ___ than cars.", "answers": ["safer"], "wrong": ["more safe", "safest", "saver"], "hint": "(safe)"}, {"id": "11", "text": "This is the ___ test we have ever had.", "answers": ["most difficult"], "wrong": ["difficultest", "more difficult", "difficulter"], "hint": "(difficult)"}, {"id": "12", "text": "My phone is not as ___ as yours.", "answers": ["expensive"], "wrong": ["more expensive", "expensiver", "most expensive"], "hint": "(expensive)"}, {"