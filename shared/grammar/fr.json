    {"id": "etre-avoir-aller-faire", "name": "être, avoir, aller, faire", "rule": "unregelmässig: je suis, j'ai, je vais, je fais – auswendig lernen", "kind": "form", "persons": ["je", "tu", "il", "elle", "on", "nous", "vous", "ils", "elles"], "verbs": {"être": {"forms": {"je": "suis", "tu": "es", "il": "est", "elle": "est", "on": "est", "nous": "sommes", "vous": "êtes", "ils": "sont", "elles": "sont"}, "wrong": ["être"]}, "avoir": {"forms": {"je": "ai", "tu": "as", "il": "a", "elle": "a", "on": "a", "nous": "avons", "vous": "avez", "ils": "ont", "elles": "ont"}, "wrong": ["avoir"]}, "aller": {"forms": {"je": "vais", "tu": "vas", "il": "va", "elle": "va", "on": "va", "nous": "allons", "vous": "allez", "ils": "vont", "elles": "vont"}, "wrong": ["aller"]}, "faire": {"forms": {"je": "fais", "tu": "fais", "il": "fait", "elle": "fait", "on": "fait", "nous": "faisons", "vous": "faites", "ils": "font", "elles": "font"}, "wrong": ["faire"]}}, "frames": [{"id": "cinema", "text": "___ au cinéma ce soir.", "verbs": ["aller"]}, {"id": "ans", "text": "___ treize ans.", "verbs": ["avoir"]}, {"id": "retard", "text": "Aujourd'hui, ___ en retard.", "verbs": ["être"]}, {"id": "sport", "text": "___ du sport le samedi.", "verbs": ["faire"]}, {"id": "chien", "text": "___ un chien et un chat.", "verbs": ["avoir"]}, {"id": "pied", "text": "___ à l'école à pied.", "verbs": ["aller"]}, {"id": "maison", "text": "Ce soir, ___ à la maison.", "verbs": ["être"]}, {"id": "courses", "text": "___ les courses au marché.", "verbs": ["faire"]}, {"id": "faim", "text": "À midi, ___ très faim.", "verbs": ["avoir"]}, {"id": "dentiste", "text": "Demain, ___ chez le dentiste.", "verbs": ["aller"]}, {"id": "lausanne", "text": "___ de Lausanne.", "verbs": ["être"]}, {"id": "gateau", "text": "Pour la fête, ___ un gâteau.", "verbs": ["faire"]}]},
