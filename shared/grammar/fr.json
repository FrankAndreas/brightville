  "topics": [
    {"id": "articles", "name": "Artikel und Geschlecht", "rule": "le (m), la (f), l' vor Vokal, les (Plural); un, une, des", "kind": "choice", "items": [{"id": "1", "text": "___ chat de Léa est noir.", "answers": ["Le"], "wrong": ["La", "Les", "L'"]}, {"id": "2", "text": "J'ai ___ sœur et deux frères.", "answers": ["une"], "wrong": ["un", "des", "la"]}, {"id": "3", "text": "___école est fermée aujourd'hui.", "answers": ["L'"], "wrong": ["La", "Le", "Les"]}, {"id": "4", "text": "Il y a ___ pommes sur la table.", "answers": ["des"], "wrong": ["un", "une", "le"]}, {"id": "5", "text": "___ maison de mes grands-parents est grande.", "answers": ["La"], "wrong": ["Le", "L'", "Les"]}, {"id": "6", "text": "Tu as ___ stylo pour moi?", "answers": ["un"], "wrong": ["une", "des", "la"]}, {"id": "7", "text": "___ enfants jouent dans le parc.", "answers": ["Les"], "wrong": ["Le", "La", "Des"]}, {"id": "8", "text": "C'est ___ hôtel très cher.", "answers": ["un"], "wrong": ["une", "le", "des"]}, {"id": "9", "text": "J'aime beaucoup ___ musique.", "answers": ["la"], "wrong": ["le", "un", "une"]}, {"id": "10", "text": "___ soleil brille.", "answers": ["Le"], "wrong": ["La", "L'", "Les"]}, {"id": "11", "text": "Nous avons ___ voiture rouge.", "answers": ["une"], "wrong": ["un", "des", "le"]}, {"id": "12", "text": "Où est ___ gare, s'il vous plaît?", "answers": ["la"], "wrong": ["le", "l'", "les"]}, {"id": "13", "text": "___ordinateur ne marche pas.", "answers": ["L'"], "wrong": ["Le", "La", "Les"]}, {"id": "14", "text": "Il mange ___ croissant.", "answers": ["un"], "wrong": ["une", "des", "la"]}, {"id": "15", "text": "Je n'aime pas ___ lundis.", "answers": ["les"], "wrong": ["le", "des", "la"]}, {"id": "16", "text": "___ mer est calme aujourd'hui.", "answers": ["La"], "wrong": ["Le", "L'", "Les"]}, {"id": "17", "text": "Il y a ___ arbre devant la maison.", "answers": ["un"], "wrong": ["une", "des", "le"]}, {"id": "18", "text": "Elle porte ___ lunettes.", "answers": ["des"], "wrong": ["