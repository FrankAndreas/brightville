    {"id": "negation", "name": "Verneinung", "rule": "ne … pas / jamais / plus / rien um das Verb; vor Vokal n'", "kind": "choice", "items": [{"id": "1", "text": "Je ___ les épinards.", "answers": ["n'aime pas"], "wrong": ["ne aime pas", "n'aime rien", "aime ne pas"], "hint": "(aimer · nicht)"}, {"id": "2", "text": "Il ___ mange jamais de viande.", "answers": ["ne"], "wrong": ["n'", "pas", "non"]}, {"id": "3", "text": "Nous n'avons ___ de pain. Il faut en acheter.", "answers": ["plus"], "wrong": ["rien", "jamais", "non"], "hint": "(nicht mehr)"}, {"id": "4", "text": "Je ne comprends ___. Tu peux répéter?", "answers": ["rien"], "wrong": ["pas", "plus", "non"], "hint": "(nichts)"}, {"id": "5", "text": "Elle ___est pas là aujourd'hui.", "answers": ["n'"], "wrong": ["ne", "pas", "non"]}, {"id": "6", "text": "Tu ne regardes ___ la télé?", "answers": ["jamais"], "wrong": ["rien", "plus", "non"], "hint": "(nie)"}, {"id": "7", "text": "Ils ne jouent ___ au foot aujourd'hui.", "answers": ["pas"], "wrong": ["rien", "non", "ne"], "hint": "(nicht)"}, {"id": "8", "text": "Je ne mange ___ de bonbons. J'ai arrêté.", "answers": ["plus"], "wrong": ["rien", "jamais", "non"], "hint": "(nicht mehr)"}, {"id": "9", "text": "On ___ fait rien ce week-end.", "answers": ["ne"], "wrong": ["n'", "pas", "non"]}, {"id": "10", "text": "Vous n'avez ___ vu?", "answers": ["rien"], "wrong": ["pas", "plus", "non"], "hint": "(nichts)"}, {"id": "11", "text": "Mon frère ne range ___ sa chambre.", "answers": ["jamais"], "wrong": ["rien", "plus", "non"], "hint": "(nie)"}, {"id": "12", "text": "Je ___habite plus à Bienne.", "answers": ["n'"], "wrong": ["ne", "pas", "non"]}, {"id": "13", "text": "Nous ne sommes ___ en retard.", "answers": ["pas"], "wrong": ["rien", "non", "ne"], "hint": "(nicht)"}, {"id": "14", "text": "Il ne dit ___. Il est timide.", "answers": ["rien"], "wrong": ["pas", "plus", "non"], "hint": "(nichts)"}, {"id": "15", "text": "Tu n'as ___ faim?", "answers": ["plus"], "wrong": ["rien", "ja