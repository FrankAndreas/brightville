    {"id": "questions", "name": "Fragen (est-ce que, Inversion)", "rule": "Frage: Est-ce que + Satz; oder Verb-Subjekt mit Bindestrich (Parles-tu …?)", "kind": "choice", "items": [{"id": "1", "text": "___ tu aimes le sport?", "answers": ["Est-ce que"], "wrong": ["Est-ce", "Qu'est-ce que", "Est que"]}, {"id": "2", "text": "Où ___ tu habites?", "answers": ["est-ce que"], "wrong": ["est-ce", "qu'est-ce que", "que"]}, {"id": "3", "text": "___ tu fais ce soir?", "answers": ["Qu'est-ce que"], "wrong": ["Est-ce que", "Qui est-ce que", "Quoi"]}, {"id": "4", "text": "___-tu français?", "answers": ["Parles"], "wrong": ["Parle", "Parlez", "Tu parles"], "hint": "(parler)"}, {"id": "5", "text": "___-vous un chien?", "answers": ["Avez"], "wrong": ["Avons", "As", "Ont"], "hint": "(avoir)"}, {"id": "6", "text": "___ est-ce que le film commence? – À huit heures.", "answers": ["À quelle heure"], "wrong": ["Quel heure", "Quand que", "Combien"]}, {"id": "7", "text": "___ coûte ce pull? – 30 francs.", "answers": ["Combien"], "wrong": ["Comment", "Quand", "Quel"]}, {"id": "8", "text": "___ tu vas? – Bien, merci.", "answers": ["Comment"], "wrong": ["Combien", "Où", "Quand"]}, {"id": "9", "text": "___ est ton anniversaire? – Le 3 mai.", "answers": ["Quand"], "wrong": ["Où", "Comment", "Qui"]}, {"id": "10", "text": "___ est-ce que tu ne viens pas? – Parce que je suis malade.", "answers": ["Pourquoi"], "wrong": ["Parce que", "Quand", "Quoi"]}, {"id": "11", "text": "___ est ta prof de français? – Madame Roth.", "answers": ["Qui"], "wrong": ["Que", "Quel", "Quoi"]}, {"id": "12", "text": "___-il à Genève?", "answers": ["Habite"], "wrong": ["Habites", "Habitent", "Il habite"], "hint": "(habiter)"}, {"id": "13", "text": "___ âge as-tu?", "answers": ["Quel"], "wrong": ["Quelle", "Combien", "Qui"]}, {"id": "14", "text": "___ couleur préfères-tu?", "answers": ["Quelle"], "wrong": ["Quel", "Qui", "Que"]}, {"id": "15", "text": "___-ils au foot le samedi?", "answers": ["Jouent"], "wrong": ["Joue", "Jou