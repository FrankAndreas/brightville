    {"id": "passe-compose-avoir", "name": "Passé composé mit avoir", "rule": "avoir (j'ai, tu as, il a …) + Partizip: mangé, fini, vu, fait, pris", "kind": "form", "persons": ["je", "tu", "il", "elle", "on", "nous", "vous", "ils", "elles"], "verbs": {"manger": {"forms": {"je": "ai mangé", "tu": "as mangé", "il": "a mangé", "elle": "a mangé", "on": "a mangé", "nous": "avons mangé", "vous": "avez mangé", "ils": "ont mangé", "elles": "ont mangé"}, "wrong": ["mangé", "manger"]}, "regarder": {"forms": {"je": "ai regardé", "tu": "as regardé", "il": "a regardé", "elle": "a regardé", "on": "a regardé", "nous": "avons regardé", "vous": "avez regardé", "ils": "ont regardé", "elles": "ont regardé"}, "wrong": ["regardé", "regarder"]}, "finir": {"forms": {"je": "ai fini", "tu": "as fini", "il": "a fini", "elle": "a fini", "on": "a fini", "nous": "avons fini", "vous": "avez fini", "ils": "ont fini", "elles": "ont fini"}, "wrong": ["fini", "finir"]}, "faire": {"forms": {"je": "ai fait", "tu": "as fait", "il": "a fait", "elle": "a fait", "on": "a fait", "nous": "avons fait", "vous": "avez fait", "ils": "ont fait", "elles": "ont fait"}, "wrong": ["fait", "faire"]}, "prendre": {"forms": {"je": "ai pris", "tu": "as pris", "il": "a pris", "elle": "a pris", "on": "a pris", "nous": "avons pris", "vous": "avez pris", "ils": "ont pris", "elles": "ont pris"}, "wrong": ["pris", "prendre"]}, "voir": {"forms": {"je": "ai vu", "tu": "as vu", "il": "a vu", "elle": "a vu", "on": "a vu", "nous": "avons vu", "vous": "avez vu", "ils": "ont vu", "elles": "ont vu"}, "wrong": ["vu", "voir"]}, "écrire": {"forms": {"je": "ai écrit", "tu": "as écrit", "il": "a écrit", "elle": "a écrit", "on": "a écrit", "nous": "avons écrit", "vous": "avez écrit", "ils": "ont écrit", "elles": "ont écrit"}, "wrong": ["écrit", "écrire"]}, "boire": {"forms": {"je": "ai bu", "tu": "as bu", "il": "a bu", "elle": "a bu", "on": "a bu", "nous": "avons bu", "vous": "avez bu", "ils": "ont bu", "elles": "ont bu"}, "wrong": ["bu", "b